{
  "name": "scroll-snooper",
  "prettyName": "Scroll Snooper",
  "codeName": "ScrollSnooper",
  "version": "2.0.0",
  "description": "Pure JavaScript API that goes snooping around elements while scrolling",
  "homepage": "https://github.com/phucbm/scroll-snooper",
  "repository": {
    "type": "git",
    "url": "git@github.com:phucbm/scroll-snooper"
  },
  "author": {
    "name": "phucbm",
    "url": "https://github.com/phucbm"
  },
  "keywords": [
    "phucbm",
    "javascript",
    "es6"
  ],
  "license": "MIT",
  "main": "./dist/scroll-snooper.module.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack serve --config config/webpack.dev.js",
    "dev-web": "cross-env NODE_ENV=development webpack serve --config config/webpack.dev-web.js",
    "build-umd": "cross-env NODE_ENV=production webpack --config config/webpack.umd.js",
    "build-module": "cross-env NODE_ENV=production webpack --config config/webpack.module.js",
    "prod": "npm run build-umd && npm run build-module",
    "build": "cross-env NODE_ENV=production webpack --config config/webpack.web.js"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.6.1",
    "sass": "^1.105.2",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  }
}
